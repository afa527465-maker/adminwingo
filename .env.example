# ==============================================================================
# WinGo Platform Environment Configuration Example
# Copy to .env and fill in your own real values. Never commit .env to Git.
# ==============================================================================

# Server port (Backend API + Admin Panel default: 3000)
PORT=3000

# Public URL of the platform (for CORS allowlisting)
APP_URL="http://localhost:3000"

# PostgreSQL Database Connection
# Option A: Single connection URI (recommended for local Docker / PostgreSQL)
DATABASE_URL="postgresql://wingo:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/wingo"

# Option B: Discrete PostgreSQL fields (used automatically if DATABASE_URL is empty)
# SQL_HOST="127.0.0.1"
# SQL_PORT="5432"
# SQL_USER="wingo"
# SQL_PASSWORD="CHANGE_ME_DB_PASSWORD"
# SQL_DB_NAME="wingo"

# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of bank account numbers
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WINGO_ENCRYPTION_KEY=""

# Optional extra passcode protecting one-time browser bootstrap if not using CLI setup
# Recommended: Run `npm run setup:admin` in your terminal to set Super Admin "Afa" password.
WINGO_ADMIN_BOOTSTRAP_PASSCODE=""

# Display currency code (USD, INR, KHR, etc.)
WINGO_CURRENCY="USD"

# Environment mode ("development" or "production")
WINGO_MODE="development"

# Optional Email (SMTP) Verification Provider — leave blank to report "Not configured"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional SMS Gateway Provider — leave blank to report "Not configured"
SMS_PROVIDER_URL=""
SMS_PROVIDER_API_KEY=""

# Player Frontend standalone API base URL (optional; leave empty when using Vite proxy)
VITE_API_BASE_URL=""
